# ==========================================
# Hope Voice Agent & Chatbot - Configuration
# ==========================================

# LiveKit Cloud Credentials
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_AGENT_NAME="my-agent-local"

# Google Gemini API Key (Gemini Live & Multimodal Audio)
GOOGLE_API_KEY="your-gemini-api-key"

# Express Backend Service URL (for transcript ingestion & memory sync)
EXPRESS_BACKEND_URL="http://localhost:5000/api/sessions/transcript"

# FalkorDB Knowledge Graph Connection
FALKORDB_HOST="localhost"
FALKORDB_PORT=6379
FALKORDB_PASSWORD=""
FALKORDB_GRAPH="therapy_memory"

# LiveKit Voice Selection (e.g. Rasalgethi, Puck, Charon, Aoede, Fenrir)
HOPE_VOICE="Rasalgethi"
